<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login | CoinMetrics</title>
    <link rel="stylesheet" href="/css/output.css">
</head>

<body class="bg-[#000000] text-white min-h-screen relative overflow-x-hidden">

    <!-- Ambient glow matching registration theme -->
    <div
        class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[500px] h-[500px] bg-emerald-500/5 rounded-full blur-[120px] pointer-events-none z-0">
    </div>

    <div class="flex flex-col justify-center items-center px-4 py-12 min-h-[calc(100vh-80px)] w-full relative z-10">

        <div class="w-full max-w-md">

            <!-- Branding Header -->
            <div class="text-center mb-8">
                <div class="inline-flex items-center gap-2 mb-3">
                    <div
                        class="relative w-9 h-9 flex items-center justify-center bg-gradient-to-br from-emerald-500 to-teal-600 rounded-xl shadow-[0_0_15px_rgba(16,185,129,0.4)] overflow-hidden">
                        <div class="absolute inset-[2px] bg-[#000000] rounded-[10px] flex items-center justify-center">
                            <svg class="w-5 h-5 text-emerald-400 animate-pulse" fill="none" stroke="currentColor"
                                viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5"
                                    d="M13 10V3L4 14h7v7l9-11h-7z">
                                </path>
                            </svg>
                        </div>
                    </div>
                    <span class="text-2xl font-extrabold tracking-wider text-white">COIN<span
                            class="text-emerald-400">METRICS</span></span>
                </div>
                <h2 class="text-gray-400 text-sm font-medium tracking-wide">Access your secure statistics terminal
                    dashboard</h2>
            </div>

            <!-- Login Form Container -->
            <div
                class="bg-white/[0.02] backdrop-blur-md border border-white/[0.06] p-8 rounded-2xl shadow-[0_20px_50px_rgba(0,0,0,0.6)]">

                <form action="/users/login" method="POST" class="space-y-5">

                    <div>
                        <label class="block text-gray-400 text-xs font-bold uppercase tracking-widest mb-2">Email
                            Address</label>
                        <input type="email" name="email" required placeholder="name@example.com"
                            class="w-full bg-[#0d0d11] border border-white/10 rounded-xl px-4 py-3.5 text-white text-sm placeholder-gray-600 focus:outline-none focus:border-emerald-400 focus:shadow-[0_0_15px_rgba(16,185,129,0.15)] transition-all duration-200">
                    </div>

                    <div>
                        <div class="flex justify-between items-center mb-2">
                            <label
                                class="block text-gray-400 text-xs font-bold uppercase tracking-widest">Password</label>
                          
                        </div>
                        <input type="password" name="password" required placeholder="••••••••"
                            class="w-full bg-[#0d0d11] border border-white/10 rounded-xl px-4 py-3.5 text-white text-sm placeholder-gray-600 focus:outline-none focus:border-emerald-400 focus:shadow-[0_0_15px_rgba(16,185,129,0.15)] transition-all duration-200">
                    </div>

                    <button type="submit"
                        class="w-full bg-emerald-400 hover:bg-emerald-500 text-[#000000] font-black text-sm tracking-wide py-3.5 rounded-xl shadow-[0_4px_20px_rgba(16,185,129,0.25)] hover:shadow-[0_4px_25px_rgba(16,185,129,0.45)] hover:scale-[1.01] active:scale-[0.99] transition-all duration-200 mt-2">
                        Sign In to Terminal
                    </button>

                </form>

                <div class="text-center mt-6 pt-6 border-t border-white/[0.06]">
                    <p class="text-xs text-gray-500">
                        Don't have an operational account?
                        <a href="/users/register"
                            class="text-emerald-400 font-semibold hover:text-emerald-300 transition-colors ml-1">Create
                            one</a>
                    </p>
                </div>

            </div>

        </div>
    </div>

    <!-- Error Popup Alert -->
    <% if (typeof error !=='undefined' && error) { %>
        <div id="login-error-popup"
            class="fixed top-24 right-6 z-[100] max-w-sm w-full bg-[#0d0d11] border border-orange-500 p-4 rounded-2xl shadow-[0_0_30px_rgba(249,115,22,0.2)] flex items-center gap-4 transition-all duration-500 ease-out transform -translate-y-10 opacity-0">
            <div
                class="relative flex-shrink-0 w-10 h-10 flex items-center justify-center bg-orange-500/10 rounded-xl border border-orange-500/20">
                <span
                    class="animate-pulse absolute inline-flex h-full w-full rounded-xl bg-orange-500/10 opacity-75"></span>
                <svg class="w-5 h-5 text-orange-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"
                    xmlns="http://www.w3.org/2000/svg">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                        d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z">
                    </path>
                </svg>
            </div>
            <div>
                <h4 class="text-white text-sm font-black tracking-wide uppercase">Authentication Failed</h4>
                <p class="text-gray-400 text-xs mt-0.5">
                    <%= error %>
                </p>
            </div>
        </div>

        <script>
            document.addEventListener("DOMContentLoaded", () => {
                const errorPopup = document.getElementById("login-error-popup");
                if (errorPopup) {
                    setTimeout(() => { errorPopup.classList.remove("-translate-y-10", "opacity-0"); }, 100);
                    setTimeout(() => {
                        errorPopup.classList.add("-translate-y-10", "opacity-0");
                        setTimeout(() => { errorPopup.remove(); }, 500);
                    }, 3100);
                }
            });
        </script>
    <% } %>

</body>

</html>