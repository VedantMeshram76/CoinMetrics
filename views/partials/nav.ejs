


 <!-- CoinGecko Style Responsive Navbar -->
<nav class="bg-[#000000] border-b border-white/[0.06] sticky top-0 z-50 backdrop-blur-md">
  
  <!-- Main Header Bar -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16 sm:h-20">

      <!-- Brand Logo -->
      <a href="/users/market" class="flex items-center gap-2 shrink-0">
        <div class="relative w-8 h-8 sm:w-9 sm:h-9 flex items-center justify-center bg-gradient-to-br from-emerald-500 to-teal-600 rounded-xl shadow-[0_0_15px_rgba(16,185,129,0.4)] overflow-hidden">
          <div class="absolute inset-[2px] bg-[#000000] rounded-[10px] flex items-center justify-center">
            <svg class="w-4 h-4 sm:w-5 sm:h-5 text-emerald-400 animate-pulse" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
            </svg>
          </div>
        </div>
        <span class="text-lg sm:text-xl font-extrabold tracking-wider text-white ml-0.5">
          COIN<span class="text-emerald-400">METRICS</span>
        </span>
      </a>

      <!-- Desktop Navigation Links -->
      <div class="hidden md:flex items-center">
        <div id="nav-tabs-container" class="relative flex items-center gap-6 lg:gap-8 font-medium text-sm text-[#8a8a93]">
          <div id="nav-indicator" class="absolute bottom-[-22px] left-0 h-[3px] bg-emerald-400 rounded-full transition-all duration-300 ease-out shadow-[0_0_12px_#10b981]"></div>

          <a href="/users/market" class="nav-tab py-2 text-gray-400 hover:text-white transition-colors duration-150" data-target="markets">Markets</a>
          <a href="/users/analytics" class="nav-tab py-2 text-gray-400 hover:text-white transition-colors duration-150" data-target="analytics">Analytics</a>
          <a href="/users/portfolio" class="nav-tab py-2 text-gray-400 hover:text-white transition-colors duration-150" data-target="portfolio">Portfolio</a>
          <a href="/users/news" class="nav-tab py-2 text-gray-400 hover:text-white transition-colors duration-150 flex items-center gap-1.5" data-target="news">
            News 
            <span class="bg-orange-500/20 text-orange-400 text-[10px] px-1.5 py-0.5 rounded-md border border-orange-500/30 font-bold uppercase tracking-wider">Live</span>
          </a>
          <a href="/users/about" class="nav-tab py-2 text-gray-400 hover:text-white transition-colors duration-150" data-target="about">About Us</a>
        </div>
      </div>

      <!-- Auth Section & User Profile Dropdown -->
      <div class="flex items-center">
        <% if (!user) { %>
          <a href="/users/login" class="bg-emerald-400 hover:bg-emerald-500 text-[#000000] font-black text-xs sm:text-sm px-4 sm:px-5 py-2 rounded-xl shadow-[0_4px_20px_rgba(16,185,129,0.25)] hover:shadow-[0_4px_25px_rgba(16,185,129,0.45)] transition-all duration-200">
            Login
          </a>
        <% } else { %>
          <div class="relative" id="user-dropdown-container">
            <!-- Dropdown Trigger Button -->
            <button id="user-menu-btn" class="flex items-center gap-2 p-1.5 sm:px-3 sm:py-2 rounded-xl bg-white/[0.04] hover:bg-white/[0.08] border border-white/10 text-white transition-all duration-200">
              <div class="w-7 h-7 sm:w-8 sm:h-8 rounded-lg bg-emerald-500/20 border border-emerald-500/40 text-emerald-400 flex items-center justify-center font-bold text-xs sm:text-sm uppercase">
                <%= user.username ? user.username.charAt(0) : 'U' %>
              </div>
              <svg class="w-4 h-4 text-gray-400 transition-transform duration-200" id="dropdown-chevron" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
              </svg>
            </button>

            <!-- Dropdown Menu Box -->
            <div id="user-dropdown-menu" class="hidden absolute right-0 mt-2 w-48 bg-[#0a0a0d] border border-white/10 rounded-xl shadow-2xl py-1 z-50 backdrop-blur-xl">
              <a href="/users/profile" class="flex items-center gap-2.5 px-4 py-2.5 text-sm font-medium text-gray-300 hover:text-white hover:bg-white/[0.06] transition-colors">
                <svg class="w-4 h-4 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M3 14h18M5 6h14a2 2 0 012 2v8a2 2 0 01-2 2H5a2 2 0 01-2-2V8a2 2 0 012-2z"/>
                </svg>
                My profile
              </a>

              <div class="border-t border-white/10 my-1"></div>

              <a href="/users/logout" class="flex items-center gap-2.5 px-4 py-2.5 text-sm font-medium text-red-400 hover:text-red-300 hover:bg-red-500/10 transition-colors">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/>
                </svg>
                Log Out
              </a>
            </div>
          </div>
        <% } %>
      </div>

    </div>
  </div>

  <!-- Mobile Horizontal Scrolling Tab Bar -->
  <div class="md:hidden border-t border-white/[0.06] bg-[#060608] overflow-x-auto no-scrollbar py-2.5 px-4">
    <div class="flex items-center gap-6 whitespace-nowrap text-xs font-semibold text-gray-400">
      <a href="/users/market" class="mobile-nav-tab hover:text-white transition-colors py-1">Markets</a>
      <a href="/users/analytics" class="mobile-nav-tab hover:text-white transition-colors py-1">Analytics</a>
      <a href="/users/portfolio" class="mobile-nav-tab hover:text-white transition-colors py-1">Portfolio</a>
      <a href="/users/news" class="mobile-nav-tab hover:text-white transition-colors py-1 flex items-center gap-1.5">
        News <span class="bg-orange-500/20 text-orange-400 text-[9px] px-1 py-0.2 rounded border border-orange-500/30">Live</span>
      </a>
      <a href="/users/about" class="mobile-nav-tab hover:text-white transition-colors py-1">About Us</a>
    </div>
  </div>

</nav>

<style>
  .no-scrollbar::-webkit-scrollbar { display: none; }
  .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
</style>

<script>
  window.addEventListener('DOMContentLoaded', () => {
    // --- Tabs Indicator & Highlighting ---
    const tabs = document.querySelectorAll('.nav-tab');
    const indicator = document.getElementById('nav-indicator');
    const currentPath = window.location.pathname;

    function moveIndicator(activeTab) {
      if (!activeTab || !indicator) return;
      indicator.style.width = `${activeTab.offsetWidth}px`;
      indicator.style.transform = `translateX(${activeTab.offsetLeft}px)`;
    }

    let currentActiveTab = Array.from(tabs).find(tab => tab.getAttribute('href') === currentPath) ||
                           Array.from(tabs).find(tab => tab.getAttribute('data-target') === 'markets');

    if (currentActiveTab) {
      tabs.forEach(t => {
        t.classList.remove('text-white');
        t.classList.add('text-gray-400');
      });
      currentActiveTab.classList.remove('text-gray-400');
      currentActiveTab.classList.add('text-white');
      setTimeout(() => moveIndicator(currentActiveTab), 60);
    }

    const mobileTabs = document.querySelectorAll('.mobile-nav-tab');
    mobileTabs.forEach(tab => {
      if (tab.getAttribute('href') === currentPath) {
        tab.classList.add('text-emerald-400', 'font-bold');
        tab.classList.remove('text-gray-400');
      }
    });

    window.addEventListener('resize', () => {
      const active = Array.from(tabs).find(t => t.classList.contains('text-white'));
      if (active) moveIndicator(active);
    });

    // --- User Dropdown Toggle Handler ---
    const menuBtn = document.getElementById('user-menu-btn');
    const menu = document.getElementById('user-dropdown-menu');
    const chevron = document.getElementById('dropdown-chevron');

    if (menuBtn && menu) {
      menuBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        menu.classList.toggle('hidden');
        chevron?.classList.toggle('rotate-180');
      });

      document.addEventListener('click', (e) => {
        if (!menu.contains(e.target) && !menuBtn.contains(e.target)) {
          menu.classList.add('hidden');
          chevron?.classList.remove('rotate-180');
        }
      });
    }
  });
</script>